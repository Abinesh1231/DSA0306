nlp = spacy.load("en_core_web_sm")

text = "The student reads a book in the library."
doc = nlp(text)

for chunk in doc.noun_chunks:
    print("Noun Phrase:", chunk.text)
    print("Meaning:", "Entity/Concept represented by the noun phrase")
